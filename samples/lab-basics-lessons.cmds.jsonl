// "Lab Basics": a lessons-mode sample built ONLY with registry commands (cf batch). Original content.
// Shows: cover image, sections, image+text, list, quote, button, accordion, tabs, flashcards, continue gates (above and
// all above), knowledge checks (mc with per-choice feedback, fill), process, labeled graphic, sorting, timeline,
// checkbox list, and a graded quiz lesson (mc, mr, fill, matching) that is the LMS completion criterion.
{"cmd":"course.set","args":{"mode":"lessons","title":"Lab Basics","description":"Three short lessons on working safely at the bench, then a quiz. About fifteen minutes."}}
{"cmd":"asset.add","args":{"id":"a-bench","path":"assets/lab-bench.svg","alt":"A lab bench with safety goggles, a flask of orange liquid, a small spill, a red spill kit and a green eyewash station."}}
{"cmd":"course.set","args":{"cover":{"image":"a-bench"}}}
{"cmd":"section.add","args":{"id":"sec-start","title":"Getting started"}}
{"cmd":"lesson.add","args":{"id":"l-welcome","title":"Welcome to the lab","blocks":[{"id":"b-w-intro","type":"text","text":"Most lab accidents start with something small: a missing pair of goggles, a flask set down too close to the edge, a spill left for later.\n\nThis course walks through the habits that prevent them. Each lesson takes a few minutes, and you can come back to any of them from the outline."},{"id":"b-w-bench","type":"imageText","image":"a-bench","text":"Everything on this bench has a job. Goggles and gloves protect you, the spill kit and eyewash station are there for when something goes wrong.","side":"right"},{"id":"b-w-goals","type":"list","items":["Choose protective equipment for the task in front of you","Respond to a spill calmly and in the right order","Check what you learned in a short quiz"]},{"id":"b-w-quote","type":"quote","text":"Safety is a habit you practise before you need it.","cite":"Lab induction notes"}]}}
{"cmd":"lesson.add","args":{"id":"l-ppe","title":"Protective equipment","blocks":[{"id":"b-p-intro","type":"text","text":"Protective equipment only works when it is the right kind and worn the right way. Open each item to see when it matters."}]}}
{"cmd":"block.add","args":{"lesson":"l-ppe","id":"b-p-acc","type":"accordion","items":[{"title":"Safety goggles","text":"Wear them whenever liquids are poured, heated or shaken, even for a quick task. Ordinary glasses do not seal at the sides."},{"title":"Gloves","text":"Match the glove material to the chemical. Change gloves as soon as they are torn or contaminated, and never touch door handles or phones with them."},{"title":"Lab coat","text":"Keep it buttoned and leave it in the lab, so whatever it caught does not travel home with you."}]}}
{"cmd":"block.add","args":{"lesson":"l-ppe","id":"b-p-gate1","type":"continue","require":"above"}}
{"cmd":"block.add","args":{"lesson":"l-ppe","id":"b-p-tabs","type":"tabs","items":[{"title":"Before","text":"Read the label and the safety sheet. Put on goggles, gloves and coat before you open anything."},{"title":"During","text":"Keep containers away from the bench edge and work with the smallest amount that does the job."},{"title":"After","text":"Close and label containers, wipe the bench, then take gloves off last and wash your hands."}]}}
{"cmd":"block.add","args":{"lesson":"l-ppe","id":"b-p-cards","type":"flashcards","items":[{"front":"Splash risk","back":"Goggles, not glasses"},{"front":"Torn glove","back":"Replace it straight away"},{"front":"Leaving the lab","back":"Coat stays behind"}]}}
{"cmd":"block.add","args":{"lesson":"l-ppe","id":"b-p-gate2","type":"continue","require":"allAbove","label":"I have explored both"}}
{"cmd":"block.add","args":{"lesson":"l-ppe","id":"b-p-head","type":"heading","text":"Check yourself"}}
{"cmd":"block.add","args":{"lesson":"l-ppe","id":"b-p-kc","type":"question","kind":"mc","prompt":"You are about to heat a solution. Which item is essential?","choices":[{"id":"a","label":"Safety goggles","correct":true,"feedback":"Right. Heated liquids can spit without warning."},{"id":"b","label":"Sandals","feedback":"Open shoes are never safe at the bench."},{"id":"c","label":"A scarf","feedback":"Loose clothing is a hazard near heat."}]}}
{"cmd":"block.add","args":{"lesson":"l-ppe","id":"b-p-gate3","type":"continue","require":"above"}}
{"cmd":"block.add","args":{"lesson":"l-ppe","id":"b-p-end","type":"text","text":"Next, you will put these habits to work on a spill.","style":{"background":"#eef1f9","padding":"normal"}}}
{"cmd":"section.add","args":{"id":"sec-practice","title":"Practice"}}
{"cmd":"lesson.add","args":{"id":"l-spill","title":"Handling a spill","blocks":[{"id":"b-s-proc","type":"process","intro":"A beaker tips over and liquid spreads across the bench. Work through the response one step at a time.","items":[{"title":"Warn","text":"Tell the people around you, clearly and at once."},{"title":"Step back","text":"Move out of splash range and keep others away."},{"title":"Assess","text":"Identify the liquid from its label. Unknown or large spills go straight to your supervisor."},{"title":"Clean up","text":"Use the spill kit, never paper towels, then report what happened."}],"summary":"Warn, step back, assess, clean up. In that order, every time."},{"id":"b-s-gate","type":"continue","require":"above"},{"id":"b-s-lg","type":"labeledGraphic","image":"a-bench","items":[{"x":24.5,"y":55.5,"title":"Goggles","text":"Within reach, not in a drawer."},{"x":50,"y":51,"title":"Flask","text":"Set well back from the edge of the bench."},{"x":74,"y":55,"title":"Spill kit","text":"Absorbent pads and neutralisers for small spills."},{"x":85.6,"y":30,"title":"Eyewash","text":"Rinse for at least fifteen minutes if anything reaches your eyes."}]},{"id":"b-s-sort","type":"sorting","categories":["Do","Don't"],"items":[{"text":"Warn people nearby","category":0},{"text":"Wipe it up with paper towels","category":1},{"text":"Use the spill kit","category":0},{"text":"Leave it for the next person","category":1}]},{"id":"b-s-tl","type":"timeline","items":[{"date":"0 s","title":"Spill happens","text":"Stop what you are doing."},{"date":"5 s","title":"Warn and step back","text":"Voice first, then distance."},{"date":"1 min","title":"Clean up","text":"Spill kit, gloves, goggles."},{"date":"10 min","title":"Report","text":"Write down what spilled and how."}]},{"id":"b-s-check","type":"list","kind":"checkbox","items":["I know where the spill kit is","I know where the eyewash station is"]},{"id":"b-s-kc","type":"question","kind":"fill","prompt":"What should you use to clean up a small spill? (two words)","answers":["spill kit","the spill kit"],"feedback":{"correct":"Yes, the spill kit.","incorrect":"Use the spill kit, never paper towels."}}]}}
{"cmd":"section.add","args":{"id":"sec-check","title":"Check"}}
{"cmd":"lesson.add","args":{"id":"l-quiz","title":"Final quiz","kind":"quiz","passPercent":75,"attempts":2,"blocks":[{"id":"q-heat","type":"question","kind":"mc","prompt":"Which protects your eyes from splashes?","choices":[{"id":"a","label":"Safety goggles","correct":true},{"id":"b","label":"Prescription glasses"},{"id":"c","label":"A face mask"}],"feedback":{"correct":"Goggles seal at the sides.","incorrect":"Only goggles seal at the sides."}},{"id":"q-spill","type":"question","kind":"mr","prompt":"Select every correct first response to a spill.","choices":[{"id":"a","label":"Warn people nearby","correct":true},{"id":"b","label":"Step back","correct":true},{"id":"c","label":"Wipe it with your sleeve"}]},{"id":"q-kit","type":"question","kind":"fill","prompt":"Which station do you use if a chemical reaches your eyes?","answers":["eyewash","eyewash station","eye wash"]},{"id":"q-match","type":"question","kind":"matching","prompt":"Match each item to its job.","pairs":[{"left":"Goggles","right":"Protect your eyes"},{"left":"Gloves","right":"Protect your hands"},{"left":"Spill kit","right":"Clean up small spills"}]}]}}
{"cmd":"block.add","args":{"lesson":"l-welcome","id":"b-w-jump","type":"button","label":"Already confident? Go to the quiz","text":"You can take the quiz at any time.","toLesson":"l-quiz"}}
{"cmd":"tracking.set","args":{"complete":[{"quiz":"l-quiz"}],"status":"passed-failed"}}
