{
  "schema": "cf.course/1",
  "id": "lab-safety",
  "title": "Lab Safety Essentials",
  "description": "A 15-minute interactive primer on everyday laboratory safety.",
  "variables": [
    {
      "name": "learner",
      "type": "text",
      "initial": "there"
    },
    {
      "name": "tabsSeen",
      "type": "number",
      "initial": 0
    },
    {
      "name": "safeChoices",
      "type": "number",
      "initial": 0
    },
    {
      "name": "reportedSpill",
      "type": "boolean",
      "initial": false
    }
  ],
  "scenes": [
    {
      "id": "sc-1",
      "title": "Welcome",
      "slides": [
        "s-welcome",
        "s-objectives"
      ]
    },
    {
      "id": "sc-ppe",
      "title": "Protective equipment",
      "slides": [
        "s-ppe"
      ]
    },
    {
      "id": "sc-scenario",
      "title": "Spill scenario",
      "slides": [
        "s-spill",
        "s-spill-good",
        "s-spill-risky",
        "s-spill-bad"
      ]
    },
    {
      "id": "sc-quiz",
      "title": "Knowledge check",
      "slides": [
        "s-q1",
        "s-q2",
        "s-q3",
        "s-q4",
        "s-results"
      ]
    }
  ],
  "slides": [
    {
      "id": "s-welcome",
      "title": "Welcome",
      "background": "#f4f1ea",
      "objects": [
        {
          "id": "o-w-band",
          "type": "shape",
          "w": 1280,
          "h": 120,
          "style": {
            "fill": "#0b4f4f"
          }
        },
        {
          "id": "o-w-title",
          "type": "text",
          "x": 80,
          "y": 30,
          "w": 1100,
          "text": "Lab Safety Essentials",
          "style": {
            "color": "#ffffff",
            "fontSize": 40,
            "bold": true
          }
        },
        {
          "id": "o-w-intro",
          "type": "text",
          "x": 80,
          "y": 170,
          "w": 720,
          "h": 160,
          "text": "Every experiment starts before you touch a flask. In about fifteen minutes you will choose the right protective gear, work through a spill, and check what you learned.",
          "style": {
            "color": "#1d1d1b",
            "fontSize": 26
          }
        },
        {
          "id": "o-w-name-label",
          "type": "text",
          "x": 80,
          "y": 360,
          "w": 500,
          "h": 40,
          "text": "What should we call you?",
          "style": {
            "fontSize": 22
          }
        },
        {
          "id": "o-w-name",
          "type": "input",
          "x": 80,
          "y": 405,
          "w": 420,
          "h": 54,
          "alt": "Your first name",
          "var": "learner",
          "placeholder": "Your first name"
        },
        {
          "id": "o-w-start",
          "type": "button",
          "x": 80,
          "y": 520,
          "w": 240,
          "h": 64,
          "text": "Start",
          "style": {
            "fill": "#0b6e6e",
            "color": "#ffffff",
            "radius": 8,
            "fontSize": 24
          },
          "states": {
            "hover": {
              "style": {
                "fill": "#095757"
              }
            }
          }
        }
      ],
      "triggers": [
        {
          "id": "t-w-start",
          "on": {
            "event": "click",
            "target": "o-w-start"
          },
          "do": [
            {
              "action": "jump",
              "to": "next"
            }
          ]
        }
      ]
    },
    {
      "id": "s-objectives",
      "title": "What you will learn",
      "objects": [
        {
          "id": "o-o-title",
          "type": "text",
          "x": 80,
          "y": 50,
          "w": 1100,
          "text": "Hi %learner%, here is the plan",
          "style": {
            "color": "#0b4f4f",
            "fontSize": 34,
            "bold": true
          }
        },
        {
          "id": "o-o-list",
          "type": "text",
          "x": 80,
          "y": 150,
          "w": 1000,
          "h": 300,
          "text": "1. Pick protective equipment for the task in front of you.\n2. Respond to a chemical spill calmly and in the right order.\n3. Prove it in a short knowledge check (80% to pass).",
          "style": {
            "fontSize": 26
          }
        }
      ]
    },
    {
      "id": "s-ppe",
      "title": "Protective equipment",
      "revisit": "resume",
      "objects": [
        {
          "id": "o-p-title",
          "type": "text",
          "x": 80,
          "y": 40,
          "w": 1100,
          "text": "Tap each item to learn when to wear it",
          "style": {
            "color": "#0b4f4f",
            "fontSize": 32,
            "bold": true
          }
        },
        {
          "id": "o-p-goggles",
          "type": "button",
          "x": 80,
          "y": 140,
          "w": 260,
          "h": 70,
          "text": "Goggles",
          "style": {
            "fill": "#e8e2d4",
            "color": "#1d1d1b",
            "radius": 8,
            "fontSize": 22
          },
          "states": {
            "visited": {
              "style": {
                "fill": "#cfe6e2"
              }
            }
          }
        },
        {
          "id": "o-p-gloves",
          "type": "button",
          "x": 80,
          "y": 230,
          "w": 260,
          "h": 70,
          "text": "Gloves",
          "style": {
            "fill": "#e8e2d4",
            "color": "#1d1d1b",
            "radius": 8,
            "fontSize": 22
          },
          "states": {
            "visited": {
              "style": {
                "fill": "#cfe6e2"
              }
            }
          }
        },
        {
          "id": "o-p-coat",
          "type": "button",
          "x": 80,
          "y": 320,
          "w": 260,
          "h": 70,
          "text": "Lab coat",
          "style": {
            "fill": "#e8e2d4",
            "color": "#1d1d1b",
            "radius": 8,
            "fontSize": 22
          },
          "states": {
            "visited": {
              "style": {
                "fill": "#cfe6e2"
              }
            }
          }
        },
        {
          "id": "o-p-progress",
          "type": "text",
          "x": 80,
          "y": 620,
          "w": 600,
          "h": 40,
          "text": "Items explored: %tabsSeen% of 3",
          "style": {
            "color": "#4a4a46",
            "fontSize": 20
          }
        },
        {
          "id": "o-p-help",
          "type": "hotspot",
          "x": 1180,
          "y": 30,
          "w": 60,
          "alt": "Help"
        }
      ],
      "layers": [
        {
          "id": "l-goggles",
          "title": "Goggles",
          "objects": [
            {
              "id": "o-lg-text",
              "type": "text",
              "x": 400,
              "y": 140,
              "w": 800,
              "h": 300,
              "text": "Goggles protect your eyes from splashes, dust and flying fragments. Wear them whenever liquids are poured, heated or shaken, even for a quick task.",
              "style": {
                "fontSize": 24
              }
            }
          ]
        },
        {
          "id": "l-gloves",
          "title": "Gloves",
          "objects": [
            {
              "id": "o-lgl-text",
              "type": "text",
              "x": 400,
              "y": 140,
              "w": 800,
              "h": 300,
              "text": "Gloves stop chemicals from reaching your skin. Match the material to the chemical and change them as soon as they are contaminated or torn.",
              "style": {
                "fontSize": 24
              }
            }
          ]
        },
        {
          "id": "l-coat",
          "title": "Lab coat",
          "objects": [
            {
              "id": "o-lc-text",
              "type": "text",
              "x": 400,
              "y": 140,
              "w": 800,
              "h": 300,
              "text": "A buttoned lab coat keeps spills off your clothes. Leave it in the lab so contamination does not travel with you.",
              "style": {
                "fontSize": 24
              }
            }
          ]
        },
        {
          "id": "l-help",
          "title": "Help",
          "objects": [
            {
              "id": "o-lh-panel",
              "type": "shape",
              "x": 340,
              "y": 160,
              "w": 600,
              "h": 360,
              "style": {
                "fill": "#ffffff",
                "border": "#0b4f4f",
                "borderWidth": 2,
                "radius": 12
              }
            },
            {
              "id": "o-lh-text",
              "type": "text",
              "x": 380,
              "y": 200,
              "w": 520,
              "h": 200,
              "text": "Select each piece of equipment. Next unlocks after you have explored all three.",
              "style": {
                "fontSize": 22
              }
            },
            {
              "id": "o-lh-close",
              "type": "button",
              "x": 540,
              "y": 430,
              "h": 56,
              "text": "Close",
              "style": {
                "fill": "#0b6e6e",
                "color": "#ffffff",
                "radius": 8
              }
            }
          ],
          "triggers": [
            {
              "id": "t-p-help-close",
              "on": {
                "event": "click",
                "target": "o-lh-close"
              },
              "do": [
                {
                  "action": "hideLayer"
                }
              ]
            }
          ],
          "hideOthers": false,
          "modal": true
        }
      ],
      "triggers": [
        {
          "id": "t-p-goggles",
          "on": {
            "event": "click",
            "target": "o-p-goggles"
          },
          "do": [
            {
              "action": "showLayer",
              "layer": "l-goggles"
            }
          ]
        },
        {
          "id": "t-p-gloves",
          "on": {
            "event": "click",
            "target": "o-p-gloves"
          },
          "do": [
            {
              "action": "showLayer",
              "layer": "l-gloves"
            }
          ]
        },
        {
          "id": "t-p-coat",
          "on": {
            "event": "click",
            "target": "o-p-coat"
          },
          "do": [
            {
              "action": "showLayer",
              "layer": "l-coat"
            }
          ]
        },
        {
          "id": "t-p-count-g",
          "on": {
            "event": "stateChange",
            "target": "o-p-goggles",
            "state": "visited"
          },
          "do": [
            {
              "action": "setVar",
              "var": "tabsSeen",
              "op": "add",
              "value": 1
            }
          ]
        },
        {
          "id": "t-p-count-gl",
          "on": {
            "event": "stateChange",
            "target": "o-p-gloves",
            "state": "visited"
          },
          "do": [
            {
              "action": "setVar",
              "var": "tabsSeen",
              "op": "add",
              "value": 1
            }
          ]
        },
        {
          "id": "t-p-count-c",
          "on": {
            "event": "stateChange",
            "target": "o-p-coat",
            "state": "visited"
          },
          "do": [
            {
              "action": "setVar",
              "var": "tabsSeen",
              "op": "add",
              "value": 1
            }
          ]
        },
        {
          "id": "t-p-help",
          "on": {
            "event": "click",
            "target": "o-p-help"
          },
          "do": [
            {
              "action": "showLayer",
              "layer": "l-help"
            }
          ]
        },
        {
          "id": "t-p-next",
          "on": {
            "event": "playerNext"
          },
          "if": {
            "all": [
              {
                "var": "tabsSeen",
                "op": ">=",
                "value": 3
              }
            ]
          },
          "do": [
            {
              "action": "jump",
              "to": "next"
            }
          ],
          "else": [
            {
              "action": "showLayer",
              "layer": "l-help"
            }
          ]
        }
      ]
    },
    {
      "id": "s-spill",
      "title": "A spill at your bench",
      "objects": [
        {
          "id": "o-s-title",
          "type": "text",
          "x": 80,
          "y": 40,
          "w": 1100,
          "text": "A beaker tips and acid spreads across the bench. What do you do first?",
          "style": {
            "color": "#0b4f4f",
            "fontSize": 30,
            "bold": true
          }
        },
        {
          "id": "o-s-a",
          "type": "button",
          "x": 80,
          "y": 160,
          "w": 900,
          "h": 72,
          "text": "Warn people nearby and step back",
          "style": {
            "fill": "#e8e2d4",
            "radius": 8,
            "fontSize": 22,
            "align": "left",
            "padding": 16
          }
        },
        {
          "id": "o-s-b",
          "type": "button",
          "x": 80,
          "y": 250,
          "w": 900,
          "h": 72,
          "text": "Grab paper towels and wipe it up",
          "style": {
            "fill": "#e8e2d4",
            "radius": 8,
            "fontSize": 22,
            "align": "left",
            "padding": 16
          }
        },
        {
          "id": "o-s-c",
          "type": "button",
          "x": 80,
          "y": 340,
          "w": 900,
          "h": 72,
          "text": "Finish the experiment first, then deal with it",
          "style": {
            "fill": "#e8e2d4",
            "radius": 8,
            "fontSize": 22,
            "align": "left",
            "padding": 16
          }
        }
      ],
      "triggers": [
        {
          "id": "t-s-a",
          "on": {
            "event": "click",
            "target": "o-s-a"
          },
          "do": [
            {
              "action": "setVar",
              "var": "safeChoices",
              "op": "add",
              "value": 1
            },
            {
              "action": "jump",
              "to": "s-spill-good"
            }
          ]
        },
        {
          "id": "t-s-b",
          "on": {
            "event": "click",
            "target": "o-s-b"
          },
          "do": [
            {
              "action": "jump",
              "to": "s-spill-risky"
            }
          ]
        },
        {
          "id": "t-s-c",
          "on": {
            "event": "click",
            "target": "o-s-c"
          },
          "do": [
            {
              "action": "jump",
              "to": "s-spill-bad"
            }
          ]
        }
      ]
    },
    {
      "id": "s-spill-good",
      "title": "Good call",
      "objects": [
        {
          "id": "o-sg-text",
          "type": "text",
          "x": 80,
          "y": 80,
          "w": 1100,
          "h": 240,
          "text": "Exactly, %learner%. Alerting others and stepping away keeps the spill from becoming an injury. Next: report it.",
          "style": {
            "fontSize": 28
          }
        },
        {
          "id": "o-sg-report",
          "type": "button",
          "x": 80,
          "y": 360,
          "w": 320,
          "h": 64,
          "text": "Report the spill",
          "style": {
            "fill": "#0b6e6e",
            "color": "#ffffff",
            "radius": 8,
            "fontSize": 22
          }
        }
      ],
      "triggers": [
        {
          "id": "t-sg-report",
          "on": {
            "event": "click",
            "target": "o-sg-report"
          },
          "do": [
            {
              "action": "setVar",
              "var": "reportedSpill",
              "op": "set",
              "value": true
            },
            {
              "action": "jumpScene",
              "to": "sc-quiz"
            }
          ]
        }
      ]
    },
    {
      "id": "s-spill-risky",
      "title": "Risky",
      "objects": [
        {
          "id": "o-sr-text",
          "type": "text",
          "x": 80,
          "y": 80,
          "w": 1100,
          "h": 240,
          "text": "Paper towels can react with some acids and you are now within splash range. Use the spill kit only after warning others.",
          "style": {
            "fontSize": 28
          }
        },
        {
          "id": "o-sr-retry",
          "type": "button",
          "x": 80,
          "y": 360,
          "w": 320,
          "h": 64,
          "text": "Try again",
          "style": {
            "fill": "#0b6e6e",
            "color": "#ffffff",
            "radius": 8,
            "fontSize": 22
          }
        }
      ],
      "triggers": [
        {
          "id": "t-sr-retry",
          "on": {
            "event": "click",
            "target": "o-sr-retry"
          },
          "do": [
            {
              "action": "jump",
              "to": "s-spill"
            }
          ]
        },
        {
          "id": "t-sr-next",
          "on": {
            "event": "playerNext"
          },
          "do": [
            {
              "action": "jump",
              "to": "s-spill"
            }
          ]
        }
      ]
    },
    {
      "id": "s-spill-bad",
      "title": "Unsafe",
      "objects": [
        {
          "id": "o-sb-text",
          "type": "text",
          "x": 80,
          "y": 80,
          "w": 1100,
          "h": 240,
          "text": "Ignoring a spill lets fumes and liquid spread to others. Stop, warn, and step back, every time.",
          "style": {
            "fontSize": 28
          }
        },
        {
          "id": "o-sb-retry",
          "type": "button",
          "x": 80,
          "y": 360,
          "w": 320,
          "h": 64,
          "text": "Try again",
          "style": {
            "fill": "#0b6e6e",
            "color": "#ffffff",
            "radius": 8,
            "fontSize": 22
          }
        }
      ],
      "triggers": [
        {
          "id": "t-sb-retry",
          "on": {
            "event": "click",
            "target": "o-sb-retry"
          },
          "do": [
            {
              "action": "jump",
              "to": "s-spill"
            }
          ]
        },
        {
          "id": "t-sb-next",
          "on": {
            "event": "playerNext"
          },
          "do": [
            {
              "action": "jump",
              "to": "s-spill"
            }
          ]
        }
      ]
    },
    {
      "id": "s-q1",
      "title": "Question 1",
      "question": {
        "type": "mc",
        "prompt": "You are about to heat a solution. Which equipment is essential?",
        "choices": [
          {
            "id": "a",
            "label": "Goggles",
            "correct": true
          },
          {
            "id": "b",
            "label": "Sandals"
          },
          {
            "id": "c",
            "label": "A scarf"
          }
        ],
        "attempts": 2,
        "feedback": {
          "correct": "Right: heating can make liquids spit.",
          "incorrect": "Goggles are essential whenever liquids are heated.",
          "tryAgain": "Not quite, think about splashes."
        }
      }
    },
    {
      "id": "s-q2",
      "title": "Question 2",
      "question": {
        "type": "mr",
        "prompt": "Select every correct response to a spill.",
        "choices": [
          {
            "id": "a",
            "label": "Warn people nearby",
            "correct": true
          },
          {
            "id": "b",
            "label": "Step back",
            "correct": true
          },
          {
            "id": "c",
            "label": "Wipe it with your sleeve"
          }
        ]
      }
    },
    {
      "id": "s-q3",
      "title": "Question 3",
      "question": {
        "type": "tf",
        "prompt": "Lab coats should be taken home to wash every evening.",
        "choices": [
          {
            "id": "t",
            "label": "True"
          },
          {
            "id": "f",
            "label": "False",
            "correct": true
          }
        ],
        "shuffle": false
      }
    },
    {
      "id": "s-q4",
      "title": "Question 4",
      "question": {
        "type": "fill",
        "prompt": "What kit should you use to clean up an acid spill? (two words)",
        "answers": [
          "spill kit",
          "a spill kit"
        ]
      }
    },
    {
      "id": "s-results",
      "title": "Results",
      "objects": [
        {
          "id": "o-r-title",
          "type": "text",
          "x": 80,
          "y": 50,
          "w": 1100,
          "text": "Your score: %qz-final.scorePercent%%",
          "style": {
            "color": "#0b4f4f",
            "fontSize": 36,
            "bold": true
          }
        },
        {
          "id": "o-r-retry",
          "type": "button",
          "x": 80,
          "y": 520,
          "w": 260,
          "h": 64,
          "text": "Retry quiz",
          "style": {
            "fill": "#0b6e6e",
            "color": "#ffffff",
            "radius": 8,
            "fontSize": 22
          }
        }
      ],
      "layers": [
        {
          "id": "l-pass",
          "title": "Passed",
          "objects": [
            {
              "id": "o-rp-text",
              "type": "text",
              "x": 80,
              "y": 160,
              "w": 1000,
              "h": 200,
              "text": "You passed, %learner%. Thanks for keeping your lab safe.",
              "style": {
                "fontSize": 28
              }
            }
          ]
        },
        {
          "id": "l-fail",
          "title": "Not yet",
          "objects": [
            {
              "id": "o-rf-text",
              "type": "text",
              "x": 80,
              "y": 160,
              "w": 1000,
              "h": 200,
              "text": "Not quite there yet. Review the equipment section and try the quiz again.",
              "style": {
                "fontSize": 28
              }
            }
          ]
        }
      ],
      "triggers": [
        {
          "id": "t-r-submit",
          "on": {
            "event": "timelineStart"
          },
          "do": [
            {
              "action": "submitQuiz",
              "quiz": "qz-final"
            }
          ]
        },
        {
          "id": "t-r-layer",
          "on": {
            "event": "timelineStart"
          },
          "if": {
            "all": [
              {
                "var": "qz-final.passed",
                "op": "==",
                "value": true
              }
            ]
          },
          "do": [
            {
              "action": "showLayer",
              "layer": "l-pass"
            }
          ],
          "else": [
            {
              "action": "showLayer",
              "layer": "l-fail"
